{
  "layer": "top",
  "position": "top",
  "height": 44,
  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "hyprland/window"
  ],
  "modules-right": [
    "network",
    "pulseaudio",
    "hyprland/language",
    "clock"
  ],
"clock": {
    "format": "<span size='130%'> </span> {:%a %d %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "hyprland/language": {
    "format": "<span size='130%'> </span> {}",
    "format-en": "EN",
    "format-no": "NO"
  },
  "network": {
    "interface": "enp7s0",
    "format-ethernet": "<span size='130%'>󰊗 </span> Online",
    "format-disconnected": "<span size='130%'>󰊗 </span> Offline",
    "max-length": 50
  },
  "pulseaudio": {
    "format": "<span size='130%'>{icon}</span>  {volume}%",
    "format-muted": "<span size='130%'> </span> Muted",
    "format-icons": {
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol"
  }
}
